  "typography": {
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Roboto, x-heart, system-ui, sans-serif, 'Apple Color Emoji', 'Twemoji Mozilla'",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "monospace": {
      "$type": "typography",
      "$value": {
        "fontFamily": "'Cascadia Code', Consolas, monospace, 'Apple Color Emoji', 'Twemoji Mozilla'",
        "fontSize": {
          "value": 0.8125,
          "unit": "rem"
        }
      }
    },
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Roboto, x-heart, system-ui, sans-serif, 'Apple Color Emoji', 'Twemoji Mozilla'",
        "fontSize": {
          "value": 1.625,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "small": {
